# apps/customer — set these in this Render service's Environment tab.
# Never commit the real .env.local file.

# --- App ---
NEXT_PUBLIC_SITE_URL=
# Render subdomain for now (e.g. https://prepped4prep-shop.onrender.com)

# --- Database & Auth (Supabase) — shared instance, customer-scoped access ---
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# No SUPABASE_SERVICE_ROLE_KEY here if avoidable — prefer RLS + the user's own
# session JWT so this app physically cannot bypass row-level security.

# --- Security & Rate Limiting (Phase 10 — POPIA Hardening) ---
ENCRYPTION_SECRET=
# 32+ character secret used for AES-256 column-level encryption (must match apps/ops)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- PayFast (Phase 3) ---
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
# set to "live" only in production once real merchant credentials are confirmed

# --- Resend Email (Phase 6) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=admin@prepped4prep.co.za

# --- AI Smart List Import (Phase 9) ---
# Server-side only. Never expose these keys to the browser/client bundle.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
