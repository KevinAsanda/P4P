# apps/ops — set these in this Render service's Environment tab.
# This app is staff-only and must never be linked from the customer app.
# Never commit the real .env.local file.

# --- App ---
NEXT_PUBLIC_SITE_URL=
# Render subdomain for now — keep this unlisted, don't link it from anywhere public.

# --- Database & Auth (Supabase) — shared instance, staff-scoped access ---
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# This app legitimately needs broader DB access (admin/warehouse/finance views),
# so the service role key lives here — never in apps/customer.

# --- Security (Phase 10 — POPIA Hardening) ---
ENCRYPTION_SECRET=
# Must match the ENCRYPTION_SECRET set in apps/customer to decrypt customer PII

# --- Resend Email (staff alerts & fulfillment notifications) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=admin@prepped4prep.co.za

# --- QuickBooks Online (Phase 8 — Accounting Sync) ---
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=
QUICKBOOKS_REALM_ID=
# Realm ID = the sandbox company ID, available after the first OAuth connection.
QUICKBOOKS_ENVIRONMENT=sandbox
# set to "production" only once a real, intentional go-live decision is made

# --- AI Bulk Product Import (Optional) ---
GEMINI_API_KEY=
